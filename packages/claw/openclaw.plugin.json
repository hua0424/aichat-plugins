{
  "id": "aichat-claw",
  "name": "AiChat Claw",
  "description": "HuLa IM Channel for openclaw (replies via the aichat CLI)",
  "version": "0.1.0",
  "entry": "dist/index.js",
  "configSchema": {
    "type": "object",
    "properties": {
      "hula": {
        "type": "object",
        "properties": {
          "serverUrl": {
            "type": "string",
            "description": "HuLa-Server HTTP API base URL"
          }
        }
      }
    }
  },
  "activation": {
    "onStartup": true
  }
}
